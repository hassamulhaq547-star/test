<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Samana View | Premium Apartments in Lahore</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    /* Custom Gold Gradient Text */
    .text-gold-gradient {
      background: linear-gradient(135deg, #fef08a 0%, #f59e0b 50%, #d97706 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
  </style>
</head>
<body class="bg-slate-900 text-slate-100 font-sans antialiased">

  <!-- FLOATING AI AGENT BUTTON -->
  <a id="floatingAiAgent" href="https://vapi.ai?demo=true&shareKey=0daddb22-81cf-4295-9af8-293b91b26e9b&assistantId=3b0912c1-00c0-4ec2-86c5-c052e89238cf" target="_blank" 
     class="fixed bottom-6 right-6 z-50 bg-amber-500 hover:bg-amber-600 text-slate-950 p-4 rounded-full shadow-2xl transition-all duration-300 hover:scale-110 flex items-center justify-center gap-2 font-bold">
    <i data-lucide="bot" class="w-6 h-6"></i>
    <span class="hidden md:inline font-semibold text-sm">Talk to AI Agent</span>
  </a>

  <!-- NAVIGATION -->
  <nav class="fixed top-0 left-0 right-0 z-40 bg-slate-950/85 backdrop-blur-md border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
      <div class="flex items-center gap-3">
        <span class="text-2xl font-serif font-bold tracking-wider text-amber-400">SAMANA VIEW</span>
        <span class="text-[10px] text-sky-400 border border-sky-500/30 px-2 py-0.5 rounded uppercase tracking-widest hidden sm:inline-block">Lahore</span>
      </div>
      <div class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
        <a href="#about" class="hover:text-amber-400 transition-colors">About</a>
        <a href="#apartments" class="hover:text-amber-400 transition-colors">Apartments</a>
        <a href="#amenities" class="hover:text-amber-400 transition-colors">Amenities</a>
        <a href="#contact" class="hover:text-amber-400 transition-colors">Contact</a>
      </div>
      <div class="flex items-center gap-3">
        <a href="https://vapi.ai?demo=true&shareKey=0daddb22-81cf-4295-9af8-293b91b26e9b&assistantId=3b0912c1-00c0-4ec2-86c5-c052e89238cf" target="_blank" class="hidden lg:flex items-center gap-2 text-xs font-semibold text-slate-950 bg-amber-400 hover:bg-amber-500 px-3.5 py-2 rounded-lg transition-all shadow">
          <i data-lucide="bot" class="w-3.5 h-3.5"></i>
          Talk to AI Agent
        </a>
        <a href="#contact" class="bg-slate-800 hover:bg-slate-700 text-amber-400 border border-amber-500/30 px-5 py-2 rounded-lg font-semibold text-sm transition-all shadow-md">
          Inquire Now
        </a>
