        <h2 class="text-3xl font-serif font-bold text-white">Featured Floor Configurations</h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Studio -->
        <div class="bg-slate-950 rounded-2xl border border-slate-800 overflow-hidden flex flex-col justify-between">
          <img src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&w=600&q=80" class="h-48 w-full object-cover">
          <div class="p-5 space-y-4">
            <div>
              <h3 class="font-bold text-white text-lg">Studio Suite</h3>
              <p class="text-sky-400 text-xs mt-1">480 - 550 Sq. Ft.</p>
              <p class="text-amber-400 font-bold text-sm mt-2">Starting from PKR 8.5M</p>
            </div>
            <a href="https://vapi.ai?demo=true&shareKey=0daddb22-81cf-4295-9af8-293b91b26e9b&assistantId=3b0912c1-00c0-4ec2-86c5-c052e89238cf" target="_blank" 
               class="w-full bg-amber-500/10 hover:bg-amber-500 border border-amber-500/30 text-amber-400 hover:text-slate-950 py-2 rounded-lg text-xs font-semibold transition-all flex items-center justify-center gap-2">
              <i data-lucide="bot" class="w-3.5 h-3.5"></i> Ask AI Agent
            </a>
          </div>
        </div>

        <!-- 1 Bed -->
        <div class="bg-slate-950 rounded-2xl border border-slate-800 overflow-hidden flex flex-col justify-between">
          <img src="https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?auto=format&fit=crop&w=600&q=80" class="h-48 w-full object-cover">
          <div class="p-5 space-y-4">
            <div>
              <h3 class="font-bold text-white text-lg">1-Bedroom Executive</h3>
              <p class="text-sky-400 text-xs mt-1">720 - 850 Sq. Ft.</p>
              <p class="text-amber-400 font-bold text-sm mt-2">Starting from PKR 13.5M</p>
            </div>
            <a href="https://vapi.ai?demo=true&shareKey=0daddb22-81cf-4295-9af8-293b91b26e9b&assistantId=3b0912c1-00c0-4ec2-86c5-c052e89238cf" target="_blank" 
               class="w-full bg-amber-500/10 hover:bg-amber-500 border border-amber-500/30 text-amber-400 hover:text-slate-950 py-2 rounded-lg text-xs font-semibold transition-all flex items-center justify-center gap-2">
              <i data-lucide="bot" class="w-3.5 h-3.5"></i> Ask AI Agent
            </a>
          </div>
        </div>

        <!-- 2 Bed -->
        <div class="bg-slate-950 rounded-2xl border border-slate-800 overflow-hidden flex flex-col justify-between">
          <img src="https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?auto=format&fit=crop&w=600&q=80" class="h-48 w-full object-cover">
          <div class="p-5 space-y-4">
            <div>
              <h3 class="font-bold text-white text-lg">2-Bedroom Luxury</h3>
              <p class="text-sky-400 text-xs mt-1">1,150 - 1,350 Sq. Ft.</p>
              <p class="text-amber-400 font-bold text-sm mt-2">Price on Request</p>
            </div>
            <a href="https://vapi.ai?demo=true&shareKey=0daddb22-81cf-4295-9af8-293b91b26e9b&assistantId=3b0912c1-00c0-4ec2-86c5-c052e89238cf" target="_blank" 
               class="w-full bg-amber-500/10 hover:bg-amber-500 border border-amber-500/30 text-amber-400 hover:text-slate-950 py-2 rounded-lg text-xs font-semibold transition-all flex items-center justify-center gap-2">
              <i data-lucide="bot" class="w-3.5 h-3.5"></i> Ask AI Agent
            </a>
          </div>
        </div>

        <!-- 3 Bed -->
        <div class="bg-slate-950 rounded-2xl border border-slate-800 overflow-hidden flex flex-col justify-between">
          <img src="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=600&q=80" class="h-48 w-full object-cover">
          <div class="p-5 space-y-4">
            <div>
              <h3 class="font-bold text-white text-lg">3-Bedroom Penthouse</h3>
              <p class="text-sky-400 text-xs mt-1">1,800 - 2,100 Sq. Ft.</p>
              <p class="text-amber-400 font-bold text-sm mt-2">Price on Request</p>
            </div>
            <a href="https://vapi.ai?demo=true&shareKey=0daddb22-81cf-4295-9af8-293b91b26e9b&assistantId=3b0912c1-00c0-4ec2-86c5-c052e89238cf" target="_blank" 
               class="w-full bg-amber-500/10 hover:bg-amber-500 border border-amber-500/30 text-amber-400 hover:text-slate-950 py-2 rounded-lg text-xs font-semibold transition-all flex items-center justify-center gap-2">
              <i data-lucide="bot" class="w-3.5 h-3.5"></i> Ask AI Agent
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- AMENITIES -->
  <section id="amenities" class="py-24 px-6 bg-slate-950 border-t border-slate-800">
    <div class="max-w-7xl mx-auto space-y-12">
      <div class="text-center max-w-xl mx-auto space-y-3">
        <span class="text-sky-400 font-semibold text-xs uppercase tracking-widest">Facilities</span>
        <h2 class="text-3xl font-serif font-bold text-white">Everything You Need, All in One Place</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <div class="p-6 bg-slate-900 border border-slate-800 rounded-2xl space-y-2">
          <div class="text-amber-400 text-2xl">🌿</div>
          <h3 class="font-bold text-white text-base">Landscaped Gardens</h3>
          <p class="text-slate-400 text-xs">Dedicated green open spaces and relaxing walking areas.</p>
        </div>

        <div class="p-6 bg-slate-900 border border-slate-800 rounded-2xl space-y-2">
          <div class="text-amber-400 text-2xl">🏋️</div>
          <h3 class="font-bold text-white text-base">Fitness Center</h3>
          <p class="text-slate-400 text-xs">Fully equipped indoor gym and wellness center.</p>
        </div>

        <div class="p-6 bg-slate-900 border border-slate-800 rounded-2xl space-y-2">
          <div class="text-amber-400 text-2xl">🛡️</div>
          <h3 class="font-bold text-white text-base">24/7 Security</h3>
          <p class="text-slate-400 text-xs">CCTV surveillance and controlled access entry points.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT FORM & AGENT PROFILE -->
  <section id="contact" class="py-24 px-6 bg-slate-900 border-t border-slate-800">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-12 gap-12">
      
      <div class="lg:col-span-5 space-y-6">
        <span class="text-amber-400 font-semibold text-xs uppercase tracking-widest">Speak With AI</span>
        <h2 class="text-3xl font-serif font-bold text-white">AI Assistant Consultation</h2>
        
        <div class="bg-slate-950 p-6 rounded-2xl border border-slate-800 space-y-4">
          <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-full bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400">
              <i data-lucide="bot" class="w-7 h-7"></i>
            </div>
            <div>
              <h3 class="font-bold text-white text-base">Samana View AI Voice Agent</h3>
              <p class="text-xs text-sky-400">Available 24/7 for instant answers</p>
            </div>
          </div>
          <p class="text-slate-400 text-xs leading-relaxed">
            Talk directly to our AI agent for updated floor plans, pricing, payment schedules, and instant booking assistance.
          </p>
          <div class="pt-2 border-t border-slate-800">
            <a href="https://vapi.ai?demo=true&shareKey=0daddb22-81cf-4295-9af8-293b91b26e9b&assistantId=3b0912c1-00c0-4ec2-86c5-c052e89238cf" target="_blank" class="flex items-center gap-2 text-amber-400 hover:text-amber-300 font-semibold text-sm transition-colors">
              <i data-lucide="bot" class="w-4 h-4"></i>
              Talk to AI Agent: +1 (934) 789 8019
            </a>
          </div>
        </div>
      </div>

      <!-- Lead Generation Form -->
      <div class="lg:col-span-7 bg-slate-950 p-8 rounded-2xl border border-slate-800">
        <h3 class="text-2xl font-serif font-bold text-white mb-6">Schedule a Consultation</h3>
        <form id="leadForm" class="space-y-4">
          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1">Full Name</label>
            <input type="text" id="buyerName" required placeholder="John Doe" 
                   class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-amber-500">
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1">Phone Number</label>
            <input type="tel" id="buyerPhone" required placeholder="+1 (934) 789 8019" 
                   class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-amber-500">
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-slate-300 mb-1">Preferred Unit</label>
              <select id="buyerUnit" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-2.5 text-sm text-slate-200 focus:outline-none">
                <option value="Studio">Studio</option>
                <option value="1-Bedroom">1-Bedroom</option>
                <option value="2-Bedroom">2-Bedroom</option>
                <option value="3-Bedroom">3-Bedroom</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-300 mb-1">Purpose</label>
              <select id="buyerPurpose" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-2.5 text-sm text-slate-200 focus:outline-none">
                <option value="Personal Residence">Residence</option>
                <option value="Investment">Investment</option>
              </select>
            </div>
          </div>

          <a href="https://vapi.ai?demo=true&shareKey=0daddb22-81cf-4295-9af8-293b91b26e9b&assistantId=3b0912c1-00c0-4ec2-86c5-c052e89238cf" target="_blank" class="w-full bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold py-3.5 rounded-lg text-sm transition-all mt-4 flex items-center justify-center gap-2">
            <i data-lucide="bot" class="w-4 h-4"></i> Call AI Agent Now (+1 934 789 8019)
          </a>
        </form>
      </div>

    </div>
  </section>

  <!-- FOOTER -->
  <footer class="bg-slate-950 border-t border-slate-900 py-8 px-6 text-center text-xs text-slate-500 flex flex-col sm:flex-row items-center justify-center gap-4">
    <p>© 2026 Samana View Lahore. All rights reserved.</p>
    <span class="hidden sm:inline text-slate-700">|</span>
    <a href="https://vapi.ai?demo=true&shareKey=0daddb22-81cf-4295-9af8-293b91b26e9b&assistantId=3b0912c1-00c0-4ec2-86c5-c052e89238cf" target="_blank" class="text-amber-400/80 hover:text-amber-400 transition-colors flex items-center gap-1.5">
      <i data-lucide="bot" class="w-3.5 h-3.5"></i> Talk to AI Agent: +1 (934) 789 8019
    </a>
  </footer>

  <script>
    // Initialize Lucide Icons
    lucide.createIcons();
  </script>
</body>
</html>
