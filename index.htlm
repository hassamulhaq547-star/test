  <!-- HERO SECTION -->
  <section class="relative min-h-screen flex items-center pt-24 pb-16 px-6 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src="https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?auto=format&fit=crop&w=1920&q=80" 
           alt="Samana View Architecture" 
           class="w-full h-full object-cover">
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/85 to-slate-950/40"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto w-full grid md:grid-cols-12 gap-12 items-center">
      <div class="md:col-span-8 space-y-6">
        <div class="inline-flex items-center gap-2 bg-sky-950/80 border border-sky-500/30 px-3.5 py-1.5 rounded-full text-sky-300 text-xs font-semibold">
          <i data-lucide="map-pin" class="w-3.5 h-3.5"></i>
          <span>Premium Location | Lahore, Pakistan</span>
        </div>
        
        <h1 class="text-4xl md:text-6xl font-serif font-extrabold text-white leading-tight">
          Elevate Your Lifestyle at <br>
          <span class="text-gold-gradient">Samana View</span>
        </h1>

        <p class="text-lg text-slate-300 max-w-xl leading-relaxed">
          Discover premium apartment living in Lahore, where contemporary architecture meets everyday comfort, convenience, and a lifestyle designed around you.
        </p>

        <div class="flex flex-wrap gap-4 pt-4">
          <a href="#apartments" class="bg-amber-500 hover:bg-amber-600 text-slate-950 px-6 py-3.5 rounded-lg font-bold text-sm transition-all shadow-lg">
            Explore Apartments
          </a>
          <a href="https://vapi.ai?demo=true&shareKey=0daddb22-81cf-4295-9af8-293b91b26e9b&assistantId=3b0912c1-00c0-4ec2-86c5-c052e89238cf" target="_blank" class="bg-slate-800 hover:bg-slate-700 text-amber-400 border border-amber-500/30 px-6 py-3.5 rounded-lg font-semibold text-sm transition-all flex items-center gap-2 shadow">
            <i data-lucide="bot" class="w-4 h-4"></i>
            Talk to AI Agent (+1 934 789 8019)
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT SECTION -->
  <section id="about" class="py-24 px-6 bg-slate-950 border-t border-slate-800">
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-12 items-center">
      <div class="space-y-6">
        <span class="text-amber-400 font-semibold text-xs uppercase tracking-widest">About The Project</span>
        <h2 class="text-3xl md:text-4xl font-serif font-bold text-white">
          More Than an Apartment. <br>A Better Way to Live.
        </h2>
        <p class="text-slate-300 leading-relaxed text-sm">
          Samana View is a modern residential development designed for individuals and families who value comfort, modern aesthetics, convenience, and a connected lifestyle in Lahore.
        </p>
        <p class="text-slate-400 leading-relaxed text-sm">
          Every floor plan is crafted to maximize space and natural light, featuring high-end fixtures and effortless access to on-site lifestyle facilities.
        </p>
      </div>

      <div class="rounded-2xl overflow-hidden border border-slate-800 shadow-2xl">
        <img src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=1000&q=80" 
             alt="Luxury Interior" class="w-full h-auto">
      </div>
    </div>
  </section>

  <!-- APARTMENT LISTINGS -->
  <section id="apartments" class="py-24 px-6 bg-slate-900">
